# Полная версия использует токены из Jupyter-ядра (Sber internal).
# Для демо-запуска укажите валидный токен GigaChat API.

# Токен авторизации GigaChat API
# В полной версии берётся из переменной окружения JPY_API_TOKEN (Jupyter kernel)
JPY_API_TOKEN=your_token_here

# Имя пользователя HDFS
# В полной версии берётся из переменной окружения NB_USER (Jupyter kernel)
NB_USER=your_username_here
